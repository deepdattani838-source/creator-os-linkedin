      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-5"
        },
        "messages": {
          "values": [
            {
              "content": "=Source material:\n{{ $json.article_text }}\n\nCreator angle and question to end on:\n{{ $json.creator_reaction }}\n\nClaims, use only the new non-repeated ones:\n{{ JSON.stringify($json.claims) }}"
            }
          ]
        },
        "options": {
          "system": "You write LinkedIn posts for a creator, following their exact four paragraph structure: an opening paragraph stating the news with two or three concrete numbers pulled directly from the source, often starting with the phrase A major; a second paragraph explaining why it matters; a third paragraph that is forward-looking and hedged, often ending with the phrase could serve as a blueprint for; and a closing line that is always a direct binary engagement question in the form Do you think A, or B. Lead the third paragraph and the closing question with the creator chosen angle, do not invent a different one. Use only facts present in the source material. Return only the post text, with no preamble or explanation.",
          "maxTokens": 1200
        }
      },
