    {
      "parameters": {
        "jsCode": "var rows = $input.all().map(function(i){ return i.json; });\nvar encoded = Buffer.from(JSON.stringify(rows)).toString(\"base64\");\nvar html = \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n<title>Creator OS - Review Queue</title>\\n<script src=\\\"https://cdn.tailwindcss.com\\\"></script>\\n<script defer src=\\\"https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js\\\"></script>\\n</head>\\n<body class=\\\"bg-gray-50 min-h-screen p-6\\\">\\n<h1 class=\\\"text-2xl font-bold mb-1\\\">Creator OS - Review Queue</h1>\\n<p class=\\\"text-gray-500 mb-6\\\">Accept, edit, or reject each draft. Every decision is logged.</p>\\n<div x-data=\\\"app()\\\" class=\\\"space-y-4 max-w-3xl\\\">\\n  <template x-for=\\\"row in rows\\\" :key=\\\"row.source_id\\\">\\n    <div class=\\\"bg-white rounded-lg shadow p-5\\\">\\n      <div class=\\\"flex justify-between items-center mb-2\\\">\\n        <span class=\\\"text-xs uppercase tracking-wide font-semibold\\\"\\n              :class=\\\"row.status === 'pending' ? 'text-amber-600' : (row.status === 'rejected' ? 'text-red-600' : 'text-green-600')\\\"\\n              x-text=\\\"row.status\\\"></span>\\n        <span class=\\\"text-xs text-gray-400\\\" x-text=\\\"row.channel + ' - ' + row.submitted_at\\\"></span>\\n      </div>\\n      <p class=\\\"text-xs text-gray-400 mb-1\\\">Voice score: <span x-text=\\\"row.voice_score\\\"></span></p>\\n      <textarea x-model=\\\"row._edit\\\" class=\\\"w-full border rounded p-2 text-sm mb-3\\\" rows=\\\"6\\\"></textarea>\\n      <div class=\\\"flex gap-2\\\" x-show=\\\"row.status === 'pending'\\\">\\n        <button @click=\\\"decide(row, 'accepted')\\\" class=\\\"bg-green-600 text-white px-3 py-1.5 rounded text-sm\\\">Accept</button>\\n        <button @click=\\\"decide(row, 'edited')\\\" class=\\\"bg-blue-600 text-white px-3 py-1.5 rounded text-sm\\\">Save as edited</button>\\n        <button @click=\\\"decide(row, 'rejected')\\\" class=\\\"bg-red-600 text-white px-3 py-1.5 rounded text-sm\\\">Reject</button>\\n      </div>\\n    </div>\\n  </template>\\n  <p x-show=\\\"rows.length === 0\\\" class=\\\"text-gray-400\\\">No drafts yet - submit one from the intake form.</p>\\n</div>\\n<script id=\\\"__data\\\" type=\\\"application/json\\\">__DATA_PLACEHOLDER__</script>\\n<script>\\nfunction app() {\\n  return {\\n    rows: JSON.parse(atob(document.getElementById('__data').textContent)).map(function(r) {\\n      r._edit = r.draft_text;\\n      return r;\\n    }),\\n    async decide(row, decision) {\\n      const base = window.location.pathname.replace(/\\\\/$/, '');\\n      const url = base + '/decide';\\n      await fetch(url, {\\n        method: 'POST',\\n        headers: { 'Content-Type': 'application/json' },\\n        body: JSON.stringify({ source_id: row.source_id, decision: decision, final_text: row._edit })\\n      });\\n      row.status = decision;\\n    }\\n  };\\n}\\n</script>\\n</body>\\n</html>\".replace(\"__DATA_PLACEHOLDER__\", encoded);\nreturn [{ json: { html: html } }];"
      },
